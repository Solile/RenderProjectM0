# ── Build output ──────────────────────────────────────────────
build/
out/
cmake-build-*/
install/

# CMake / Ninja scratch
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.ninja
.ninja_deps
.ninja_log
compile_commands.json

# ── Compiled binaries & intermediates ─────────────────────────
*.exe
*.dll
*.obj
*.o
*.lib
*.a
*.pdb
*.ilk
*.exp
# compiled shader blobs (shaders are compiled at build/run time)
*.cso

# ── Fetched assets (pulled by tools/fetch_assets.py, not committed) ──
assets/
!assets/.gitkeep

# ── Benchmark output (not committed, except .md reports) ──
# results/m0/, results/A/, results/B/. Ignore files, not the directory,
# so the negation below can re-include reports.
results/**
!results/**/
!results/**/*.md

# ── Screen captures (golden/ IS committed; ad-hoc captures are not) ──
captures/

# ── IDE / editor ──────────────────────────────────────────────
.vs/
.vscode/
*.user
*.sln
*.vcxproj*

# ── Python tooling ────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── OS cruft ──────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
